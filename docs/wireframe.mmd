graph TD    %% ノードのスタイル定義    classDef root fill:#f9f,stroke:#333,stroke-width:2px;    classDef round fill:#fff,stroke:#333,stroke-width:2px,rx:20,ry:20;    classDef rect fill:#fff,stroke:#333,stroke-width:2px;    classDef active fill:#ff0,stroke:#f00,stroke-width:4px;    %% 階層構造の定義    ANTENNA((アンテナ)):::root        %% 第1階層    E(E / ○):::round    T[T / ▭]:::rect        %% 第2階層    I(I / ○):::round    A[A / ▭]:::rect    N(N / ○):::round    M[M / ▭]:::rect    %% 第3階層    S(S / ○):::round    U[U / ▭]:::rect    R(R / ○):::round    W[W / ▭]:::rect    D(D / ○):::round    K[K / ▭]:::rect    G(G / ○):::round    O[O / ▭]:::rect    %% 接続（遷移パス）    ANTENNA -- 短押し --> E    ANTENNA -- 長押し --> T        E -- 短押し --> I    E -- 長押し --> A    T -- 短押し --> N    T -- 長押し --> M        I -- 短押し --> S    I -- 長押し --> U    A -- 短押し --> R    A -- 長押し --> W    N -- 短押し --> D    N -- 長押し --> K    M -- 短押し --> G    M -- 長押し --> O    %% 操作ボタンの概念（画面配置用）    subgraph 操作エリア        BTN[メインボタン<br/>短押し: ○点灯 / 長押し: ▭点灯]    end    %% 注釈    style BTN fill:#ddd,stroke-dasharray: 5 5